[TEMPLATE]
# คัดลอกเป็น .env แล้วเติมค่า (.env ถูก gitignore)

# ---------------- gateway ----------------
# IP ของ ESP32 gateway (ใช้ตอนกดหยุดฉุกเฉินจาก dashboard)
GATEWAY_URL=http://192.168.1.60:80

# token ที่ gateway แนบมาใน header X-Auth-Token
# ตั้งให้ตรงกับ API_TOKEN ใน board/gateway/secrets.h (เว้นว่าง = ไม่ตรวจ)
INGEST_TOKEN=

# ---------------- การแจ้งเตือน ----------------
DISCORD_WEBHOOK_URL=
# ชนิดเหตุการณ์ที่ยิง Discord (คั่นด้วย ,)
NOTIFY_KINDS=humidity,gas,estop,fan

# ---------------- cloud storage ----------------
# ทางง่ายสุด: Apps Script Web App (ดู apps_script.gs) ลงท้ายด้วย /exec
GOOGLE_SCRIPT_URL=
# ทางเลือก: service account
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json

# auto = ใช้ Apps Script ถ้าตั้ง URL / ไม่ตั้งอะไรเลยใช้ SQLite ในเครื่อง
# script = บังคับ Apps Script / sheets = บังคับ service account / local = บังคับ SQLite
CLOUD_BACKEND=auto

# ---------------- ตรรกะฝั่ง cloud ----------------
ONLINE_WINDOW_S=15
PICK_COOLDOWN_S=5
# จำนวนวินาทีที่แคชแถวจากชีตก่อนอ่านใหม่ (ประหยัด quota)
CLOUD_READ_TTL_S=8

# ที่เก็บ SQLite (ไม่ต้องแก้)
# WEARWISE_DB=cloud.db
