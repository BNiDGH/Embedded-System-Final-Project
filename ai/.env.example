[TEMPLATE]
# คัดลอกเป็น .env แล้วเติมค่า

# auto = YOLO ถ้าติดตั้ง ultralytics / ไม่มีใช้ OpenCV HOG
# yolo|hog = บังคับ
AI_BACKEND=auto
AI_MODEL=yolov8n.pt
AI_CONF=0.35

# auto = ใช้ torchvision MobileNet ถ้าติดตั้งไว้ / color = ใช้กฎสี
AI_CLASSIFIER=auto
AI_DEVICE=cpu

# token ที่ gateway แนบมาใน header X-Auth-Token (ควรตรงกับ cloud)
INGEST_TOKEN=
